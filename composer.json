{
    "name": "smile/module-retailer-promotion",
    "type": "magento2-module",
    "description": "Smile Retailer Promotion",
    "keywords": ["magento2", "retailer promotion", "retailer"],
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "require": {
        "php": "^8.3",
        "magento/framework": ">=103.0.7",
        "magento/module-store": "*",
        "magento/module-checkout": "*",
        "smile/module-retailer": "^2.0",
        "smile/module-store-locator": "^2.2"
    },
    "require-dev": {
        "smile/magento2-smilelab-quality-suite": "^4.0"
    },
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "Fanny DECLERCK",
            "email": "fadec@smile.fr"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Smile\\RetailerPromotion\\" : ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    }
}
